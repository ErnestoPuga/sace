{
  "ConnectionStrings": { "DefaultConnection": "Data Source=sace.db" },
  "Jwt": { "Issuer": "SACE", "Audience": "SACE.Client" },
  "Storage": { "RootPath": "../storage" },
  "Uploads": { "MaxFileSizeMb": 25 },
  "DataProtection": { "KeysPath": ".keys" },
  "Seed": { "DemoData": false },
  "PilotUser": { "Enabled": false },
  "Swagger": { "Enabled": false },
  "DailyAudit": { "Enabled": true, "RunAtHourUtc": 6 },
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore.Database.Command": "Warning" } },
  "AllowedHosts": "*"
}
