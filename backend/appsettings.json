{
  "ConnectionStrings": { "DefaultConnection": "Data Source=sace.db" },
  "Jwt": { "Issuer": "SACE", "Audience": "SACE.Client" },
  "Storage": { "RootPath": "../storage" },
  "Uploads": { "MaxFileSizeMb": 25 },
  "DataProtection": { "KeysPath": ".keys" },
  "Seed": { "DemoData": false },
  "PilotUser": { "Enabled": false },
  "Swagger": { "Enabled": false },
  "Classification": { "HighConfidence": 0.85, "MediumConfidence": 0.60, "FilenameWeight": 0.55, "TextSignalWeight": 0.22 },
  "Valuation": { "AbsoluteTolerance": 0.01, "PercentTolerance": 0.01 },
  "Contribution": { "AbsoluteTolerance": 0.01, "EnableTechnicalRateCalculation": false },
  "BatchAudit": { "MaxOperationsPerBatch": 500 },
  "Pagination": { "MaxPageSize": 100 },
  "DocumentReconciliation": { "MaxLineItemsPerDocument": 500 },
  "DocumentIntelligence": { "MaxPages": 100, "MaxDocumentSizeMb": 25, "MaxLineItems": 500, "OcrMaxPages": 20, "MinimumNativeTextCharacters": 40, "Ocr": { "Enabled": false, "Languages": ["spa", "eng"], "ExecutablePath": "", "Arguments": "\"{input}\" stdout -l {languages}" } },
  "ImmexInventory": { "DueSoonDays": 90, "CriticalDays": 30 },
  "DailyAudit": { "Enabled": true, "RunAtHourUtc": 6 },
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore.Database.Command": "Warning" } },
  "AllowedHosts": "*"
}
